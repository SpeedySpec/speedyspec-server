<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="token-map-bootstrap.php"
    colors="false"
    cacheResult="false"
    failOnWarning="false"
    failOnDeprecation="false"
    displayDetailsOnTestsThatTriggerDeprecations="true"
    displayDetailsOnPhpunitDeprecations="false"
>
    <testsuites>
        <testsuite name="wordpress-token-map">
            <directory suffix=".php">wordpress/token-map</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>documented-break</group>
        </exclude>
    </groups>
</phpunit>
