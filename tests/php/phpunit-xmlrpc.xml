<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="bootstrap-xmlrpc.php"
    colors="false"
    cacheResult="false"
    failOnWarning="false"
    failOnDeprecation="false"
    displayDetailsOnTestsThatTriggerDeprecations="true"
    displayDetailsOnTestsThatTriggerWarnings="true"
    displayDetailsOnPhpunitDeprecations="false"
>
    <testsuites>
        <testsuite name="wordpress-xmlrpc">
            <directory suffix=".php">wordpress/xmlrpc</directory>
        </testsuite>
    </testsuites>
</phpunit>
