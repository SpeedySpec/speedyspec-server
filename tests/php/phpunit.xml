<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="bootstrap.php"
    colors="false"
    cacheResult="false"
    failOnWarning="false"
    failOnDeprecation="false"
    displayDetailsOnTestsThatTriggerDeprecations="true"
    displayDetailsOnPhpunitDeprecations="false"
>
    <testsuites>
        <testsuite name="wordpress-hooks">
            <file>wordpress/actions.php</file>
            <file>wordpress/filters.php</file>
            <directory suffix=".php">wordpress/hooks</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>documented-break</group>
        </exclude>
    </groups>
</phpunit>
