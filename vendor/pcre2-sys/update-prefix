#!/bin/sh
# Regenerates prefix.h after the vendored PCRE2 changes: every external symbol the library defines gets a
# `#define` to its speedyspec_-prefixed name. Run from the workspace root:
#
#   vendor/pcre2-sys/update-prefix
#
# It builds the library with an empty prefix.h first, so the list is the stock names.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
printf '/* Placeholder while update-prefix runs. */\n' > "$here/prefix.h"
cargo build -p pcre2-sys --quiet
lib=$(ls -t target/debug/build/pcre2-sys-*/out/libpcre2.a | head -1)
{
    printf '/* Generated by update-prefix: do not edit. Every external symbol of the vendored PCRE2, renamed so it\n'
    printf '   never collides with the static PHP'"'"'s PCRE2, which keeps the stock names for its internals. */\n\n'
    printf '#ifndef SPEEDYSPEC_PCRE2_PREFIX_H\n#define SPEEDYSPEC_PCRE2_PREFIX_H\n\n'
    # Mach-O prefixes C names with an underscore; ELF does not.
    case "$(uname)" in Darwin) strip='s/^_//' ;; *) strip='' ;; esac
    nm -g -U "$lib" 2>/dev/null | awk 'NF == 3 { print $3 }' | sed "$strip" | sort -u | \
        awk '{ printf "#define %s speedyspec_%s\n", $1, $1 }'
    printf '\n#endif\n'
} > "$here/prefix.h.new"
mv "$here/prefix.h.new" "$here/prefix.h"
cargo build -p pcre2-sys --quiet
echo "prefix.h: $(grep -c '^#define .* speedyspec_' "$here/prefix.h") symbols"
