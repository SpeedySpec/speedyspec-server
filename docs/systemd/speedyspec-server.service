# The SpeedySpec web server, in managed mode.
#
# Install the binary at /usr/local/bin/speedyspec-server and a config at /etc/speedyspec/server.toml with
#   data_dir = "/var/lib/speedyspec"
#   run_dir = "/run/speedyspec"
# then: systemctl enable --now speedyspec-server

[Unit]
Description=SpeedySpec web server
Documentation=https://github.com/SpeedySpec/speedyspec-server
After=network-online.target
Wants=network-online.target

[Service]
# The keeper sends READY=1 once its first generation is serving.
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/speedyspec-server run --config /etc/speedyspec/server.toml
# A handoff to a new generation that re-reads the config; listener changes need a restart.
ExecReload=/usr/local/bin/speedyspec-server reload --config /etc/speedyspec/server.toml
# SIGTERM to the keeper only; it drains its generation (up to [handoff] drain_timeout) and exits.
KillMode=mixed
TimeoutStopSec=6min
Restart=on-failure
RestartSec=2s
# /run/speedyspec (keeper.sock, server.lock) and /var/lib/speedyspec (releases, state.json).
RuntimeDirectory=speedyspec
RuntimeDirectoryMode=0700
StateDirectory=speedyspec
StateDirectoryMode=0700
User=speedyspec
Group=speedyspec
# Binding ports below 1024 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
